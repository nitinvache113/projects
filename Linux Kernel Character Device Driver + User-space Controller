1) Kernel module: core ideas & code

This is a complete but compact kernel module. It uses polling worker (kernel thread) to trigger the sensor and measure echo pulse width using gpiod_* APIs (preferred kernel GPIO API). It exposes a simple read() that returns a newline-terminated string with the latest distance in cm.

Note: On Raspberry Pi, you must ensure CONFIG_GPIOLIB/gpiod support and choose correct GPIO numbers. Running kernel modules requires root.

ultrasonic_drv.c
// ultrasonic_drv.c
#include <linux/module.h>
#include <linux/init.h>
#include <linux/kernel.h>
#include <linux/fs.h>
#include <linux/uaccess.h>
#include <linux/gpio/consumer.h>
#include <linux/delay.h>
#include <linux/kthread.h>
#include <linux/mutex.h>
#include <linux/wait.h>
#include <linux/timekeeping.h>

#define DEVICE_NAME "ultrasonic0"
#define BUF_LEN 64
#define DEFAULT_PERIOD_MS 500

static int major;
static struct class *ultrasonic_class;
static struct device *ultrasonic_device;

static struct gpio_desc *gpiod_trig;
static struct gpio_desc *gpiod_echo;

static struct task_struct *measure_thread;
static unsigned int sample_period_ms = DEFAULT_PERIOD_MS;

static char data_buf[BUF_LEN];
static DEFINE_MUTEX(data_lock);
static DECLARE_WAIT_QUEUE_HEAD(data_wq);
static atomic_t data_ready = ATOMIC_INIT(0);

/* Helper: generate 10us pulse on TRIG */
static void trig_pulse(void)
{
    gpiod_set_value(gpiod_trig, 1);
    udelay(10);
    gpiod_set_value(gpiod_trig, 0);
}

/* Measure echo pulse width in microseconds. Return -1 on timeout */
static long measure_pulse_us(void)
{
    struct timespec64 ts_start, ts_end;
    long timeout_us = 30000; // 30 ms timeout (no echo)
    long elapsed = 0;
    unsigned int val;

    // Wait for echo to go HIGH
    do {
        val = gpiod_get_value(gpiod_echo);
        if (val) break;
        udelay(1);
        timeout_us--;
        if (timeout_us <= 0) return -1;
    } while (1);

    ktime_get_real_ts64(&ts_start);

    // Wait for echo to go LOW
    timeout_us = 30000;
    do {
        val = gpiod_get_value(gpiod_echo);
        if (!val) break;
        udelay(1);
        timeout_us--;
        if (timeout_us <= 0) return -1;
    } while (1);

    ktime_get_real_ts64(&ts_end);

    elapsed = (ts_end.tv_sec - ts_start.tv_sec) * 1000000LL
            + (ts_end.tv_nsec - ts_start.tv_nsec) / 1000LL;
    return elapsed;
}

/* Kernel thread: periodic sampling */
static int measure_thread_fn(void *arg)
{
    while (!kthread_should_stop()) {
        trig_pulse();
        msleep(1); // small wait for sensor to set echo
        long pulse_us = measure_pulse_us();
        if (pulse_us > 0) {
            // distance in cm: (pulse_us / 2) * speed_of_sound(0.0343 cm/us)
            double distance = (pulse_us / 2.0) * 0.0343;
            mutex_lock(&data_lock);
            snprintf(data_buf, BUF_LEN, "DIST:%.2f\n", distance);
            mutex_unlock(&data_lock);
            atomic_set(&data_ready, 1);
            wake_up_interruptible(&data_wq);
        } else {
            mutex_lock(&data_lock);
            snprintf(data_buf, BUF_LEN, "DIST:ERR\n");
            mutex_unlock(&data_lock);
            atomic_set(&data_ready, 1);
            wake_up_interruptible(&data_wq);
        }
        msleep(sample_period_ms);
    }
    return 0;
}

/* Char device file ops */
static ssize_t ultrasonic_read(struct file *filp, char __user *buf, size_t count, loff_t *f_pos)
{
    int ret;
    // Wait for data
    if (!atomic_read(&data_ready)) {
        if (wait_event_interruptible(data_wq, atomic_read(&data_ready)))
            return -ERESTARTSYS;
    }

    mutex_lock(&data_lock);
    ret = simple_read_from_buffer(buf, count, f_pos, data_buf, strlen(data_buf));
    mutex_unlock(&data_lock);

    atomic_set(&data_ready, 0);
    return ret;
}

static ssize_t ultrasonic_write(struct file *filp, const char __user *buf, size_t count, loff_t *f_pos)
{
    // accept simple commands: "PERIOD <ms>"
    char kbuf[32];
    if (count >= sizeof(kbuf)) return -EFAULT;
    if (copy_from_user(kbuf, buf, count)) return -EFAULT;
    kbuf[count] = 0;

    if (sscanf(kbuf, "PERIOD %u", &sample_period_ms) == 1) {
        pr_info("ultrasonic: period set to %u ms\n", sample_period_ms);
        return count;
    }
    return -EINVAL;
}

static const struct file_operations ultrasonic_fops = {
    .owner = THIS_MODULE,
    .read  = ultrasonic_read,
    .write = ultrasonic_write,
};

static int __init ultrasonic_init(void)
{
    int ret;
    pr_info("ultrasonic: init\n");

    major = register_chrdev(0, DEVICE_NAME, &ultrasonic_fops);
    if (major < 0) {
        pr_err("ultrasonic: register_chrdev failed\n");
        return major;
    }

    ultrasonic_class = class_create(THIS_MODULE, "ultrasonic");
    if (IS_ERR(ultrasonic_class)) {
        unregister_chrdev(major, DEVICE_NAME);
        return PTR_ERR(ultrasonic_class);
    }

    ultrasonic_device = device_create(ultrasonic_class, NULL, MKDEV(major, 0), NULL, DEVICE_NAME);
    if (IS_ERR(ultrasonic_device)) {
        class_destroy(ultrasonic_class);
        unregister_chrdev(major, DEVICE_NAME);
        return PTR_ERR(ultrasonic_device);
    }

    // Obtain GPIO descriptors by consumer labels (device tree) or by GPIO numbers
    // For simplicity use gpio_request by number (change to your GPIOs)
    // Better: use gpiod_get_optional() with consumer name and line numbers from DT
    gpiod_trig = gpio_to_desc(23); // change to actual trig gpio
    gpiod_echo = gpio_to_desc(24); // change to actual echo gpio
    if (!gpiod_trig || !gpiod_echo) {
        pr_err("ultrasonic: failed to get gpio descriptors\n");
        device_destroy(ultrasonic_class, MKDEV(major, 0));
        class_destroy(ultrasonic_class);
        unregister_chrdev(major, DEVICE_NAME);
        return -ENODEV;
    }

    gpiod_direction_output(gpiod_trig, 0);
    gpiod_direction_input(gpiod_echo);

    measure_thread = kthread_run(measure_thread_fn, NULL, "ultra_thread");
    if (IS_ERR(measure_thread)) {
        pr_err("ultrasonic: could not create thread\n");
        device_destroy(ultrasonic_class, MKDEV(major, 0));
        class_destroy(ultrasonic_class);
        unregister_chrdev(major, DEVICE_NAME);
        return PTR_ERR(measure_thread);
    }

    pr_info("ultrasonic: module loaded, major=%d\n", major);
    return 0;
}

static void __exit ultrasonic_exit(void)
{
    pr_info("ultrasonic: exit\n");
    if (measure_thread)
        kthread_stop(measure_thread);
    device_destroy(ultrasonic_class, MKDEV(major, 0));
    class_destroy(ultrasonic_class);
    unregister_chrdev(major, DEVICE_NAME);
    pr_info("ultrasonic: module unloaded\n");
}

module_init(ultrasonic_init);
module_exit(ultrasonic_exit);

MODULE_LICENSE("GPL");
MODULE_AUTHOR("Nitin");
MODULE_DESCRIPTION("Ultrasonic sensor char device driver (demo)");


Important implementation notes

gpio_to_desc() usage above is a placeholder. On many systems you should use gpiod_get() / devm_gpiod_get() with device tree or specify GPIO by number via gpio_request(). Adjust based on your target platform. On Raspberry Pi, many people use the gpio sysfs in user-space, or gpiod consumer API in kernel modules with correct device binding.

The module spawns a kernel thread (kthread_run) to do periodic measuring so heavy work is not done in ISR. The thread uses gpiod_get_value() to read echo pin — this is simple but can work for demos.

For production/real-time, prefer hardware timers or avoid busy-wait loops.

