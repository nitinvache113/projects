Each sensor monitors one parking slot.
If the distance < threshold (e.g., 10 cm), the slot is occupied, else it’s available.

🧰 Circuit Connections
Arduino Pin	Sensor	Description
7	Trig (Sensor 1)	Trigger signal
6	Echo (Sensor 1)	Echo signal
5	Trig (Sensor 2)	Trigger signal
4	Echo (Sensor 2)	Echo signal
2	Green LED	Slot Available
3	Red LED	Slot Occupied
5V & GND	Common Power	Sensors & LEDs

You can expand this for more slots (up to 6–8 sensors depending on board).

💻 Arduino Code (C Language)

Copy this into Arduino IDE → save as SmartParking.ino → upload to board.

#define trigPin1 7
#define echoPin1 6
#define trigPin2 5
#define echoPin2 4

#define greenLED 2
#define redLED 3

long duration1, distance1;
long duration2, distance2;

void setup() {
  Serial.begin(9600);
  pinMode(trigPin1, OUTPUT);
  pinMode(echoPin1, INPUT);
  pinMode(trigPin2, OUTPUT);
  pinMode(echoPin2, INPUT);
  pinMode(greenLED, OUTPUT);
  pinMode(redLED, OUTPUT);
  Serial.println("Smart Parking System Initialized");
}

void loop() {
  // Slot 1
  digitalWrite(trigPin1, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin1, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin1, LOW);
  duration1 = pulseIn(echoPin1, HIGH);
  distance1 = duration1 * 0.034 / 2;

  // Slot 2
  digitalWrite(trigPin2, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin2, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin2, LOW);
  duration2 = pulseIn(echoPin2, HIGH);
  distance2 = duration2 * 0.034 / 2;

  // Determine slot status
  String slot1 = (distance1 < 10) ? "OCCUPIED" : "EMPTY";
  String slot2 = (distance2 < 10) ? "OCCUPIED" : "EMPTY";

  // Print to Serial
  Serial.print("Slot 1: "); Serial.print(slot1);
  Serial.print(" | Distance: "); Serial.print(distance1); Serial.println(" cm");
  Serial.print("Slot 2: "); Serial.print(slot2);
  Serial.print(" | Distance: "); Serial.print(distance2); Serial.println(" cm");
  Serial.println("-----------------------------");

  // LED indication
  if (slot1 == "OCCUPIED" || slot2 == "OCCUPIED") {
    digitalWrite(redLED, HIGH);
    digitalWrite(greenLED, LOW);
  } else {
    digitalWrite(redLED, LOW);
    digitalWrite(greenLED, HIGH);
  }

  delay(2000);
}


✅ This code detects whether slots are occupied or not and prints the status every 2 seconds.

📊 Python Visualization Code

Now, to visualize live parking slot data in Python using Serial communication.

Install required modules:

pip install pyserial matplotlib


Save as parking_visual.py

import serial
import matplotlib.pyplot as plt
from time import sleep

# Adjust COM port according to your PC
arduino = serial.Serial('COM4', 9600)

print("Connected to Arduino... Reading data")

while True:
    line = arduino.readline().decode().strip()
    if "Slot 1" in line:
        print(line)
    sleep(1)


